# ── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://uyt:uyt@localhost:5432/uyt
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
TRUST_PROXY=false

# ── Push: Firebase Cloud Messaging (Android) ────────
# Service-account JSON (raw, base64, or a file path) from Firebase console → Project settings → Service accounts
FIREBASE_SERVICE_ACCOUNT=

# ── Push: Apple Push Notification service (iOS) ──────
# Apple Developer → Keys → create a key with APNs enabled (.p8)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=./secrets/AuthKey.p8
APNS_BUNDLE_ID=app.uyt.customer
APNS_PRODUCTION=false

# ── Push: Web Push (browser customers) ───────────────
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@uyt.app

# Optional Expo push access token (development builds / Expo Go fallback)
EXPO_ACCESS_TOKEN=

# Development only: log pushes instead of sending them
PUSH_MOCK=false
