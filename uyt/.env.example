# Copy to .env for docker compose. See server/.env.example for every option.
POSTGRES_PASSWORD=change-me
WEB_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PUBLIC_WEB_URL=https://uyt.app
PUBLIC_API_URL=https://uyt.app
CORS_ORIGINS=https://uyt.app
FIREBASE_SERVICE_ACCOUNT=/app/secrets/firebase-service-account.json
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=/app/secrets/AuthKey.p8
APNS_BUNDLE_ID=app.uyt.customer
APNS_PRODUCTION=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@uyt.app
