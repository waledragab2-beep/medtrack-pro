{
  "expo": {
    "name": "UYT",
    "slug": "uyt",
    "scheme": "uyt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "primaryColor": "#E10600",
    "description": "UYT – your order is ready! Scan the store QR, get an alert with sound and vibration when your order is ready.",
    "ios": {
      "bundleIdentifier": "app.uyt.customer",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:uyt.app"
      ],
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "UYT uses the camera to scan the store QR code and link your order.",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.uyt.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "uyt.app",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "uyt.app",
              "pathPrefix": "/o/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E10600",
          "defaultChannel": "order-ready",
          "sounds": [
            "./assets/sounds/ready.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "UYT uses the camera to scan the store QR code and link your order.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "apiUrl": "https://api.uyt.app",
      "webUrl": "https://uyt.app",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}