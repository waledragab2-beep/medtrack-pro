{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://192.168.1.10:4000", "EXPO_PUBLIC_WEB_URL": "http://192.168.1.10:5173" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://staging-api.uyt.app", "EXPO_PUBLIC_WEB_URL": "https://staging.uyt.app" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.uyt.app", "EXPO_PUBLIC_WEB_URL": "https://uyt.app" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "serviceAccountKeyPath": "./secrets/play-service-account.json" },
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID" }
    }
  }
}
